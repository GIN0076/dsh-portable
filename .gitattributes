# Normalize line endings: scripts/cmd files stay CRLF (Windows), code stays LF.
* text=auto

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf

*.md text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.d.ts text eol=lf

*.exe binary
*.7z binary
*.png binary
*.jpg binary
*.ico binary
